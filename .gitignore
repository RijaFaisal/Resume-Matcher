# ==================== DATA ====================
# Exclude raw and processed data (too large for git)
data/raw/*.csv
data/raw/*.json
data/processed/*.csv
data/processed/*.json

# Keep directory structure with .gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# ==================== MODELS ====================
# Exclude trained models (use DVC or S3 instead)
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.pth
models/*.onnx
models/*.pb

# Keep directory structure
!models/.gitkeep
!models/README.md

